# MongoDB Atlas connection string (required for backend database)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/auryx?retryWrites=true&w=majority"

# Secret key used to sign and verify JWT authentication tokens
JWT_SECRET="replace_with_a_long_random_secret_string"

# Port for standalone Express backend (when running server/index.ts separately)
PORT="5000"

# Allowed frontend origin for CORS (when running frontend and backend on separate ports)
CLIENT_URL="http://localhost:3000"

# Public frontend API base URL (leave empty when using Vite proxy or same-origin server.ts)
VITE_API_URL=""

# Optional AI Studio runtime variables
GROQ_API_KEY="your_groq_api_key_here"
APP_URL="MY_APP_URL"
