# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/auryx?retryWrites=true&w=majority"

# Secret key for signing JWT authentication tokens (use a strong random string)
JWT_SECRET="replace_with_a_long_random_secret_string"

# Port for the Express API server
PORT="5000"

# Frontend origin allowed by CORS
CLIENT_URL="http://localhost:3000"
